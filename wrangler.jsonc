{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-redis-kv-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-03",
  "workers_dev": true,
  "alias": {
    "hono": "./node_modules/hono"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NAMESPACE",
        "class_name": "NamespaceDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChannelPubSubDurableObject"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["ChannelPubSubDurableObject"],
      "new_sqlite_classes": ["NamespaceDO"]
    }
  ],
  "vars": {
    "ALLOW_UNAUTHENTICATED": "false",
    "DEFAULT_NAMESPACE": "default"
  }
}
